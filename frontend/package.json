    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  }
